#!/usr/bin/env python3
from __future__ import annotations

import getpass
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Iterable, Optional, NoReturn


MACHINE_NAME = os.environ.get("MACHINE_NAME", "debian")
CONTAINER_ROOT = Path(os.environ.get("CONTAINER_ROOT", f"/var/lib/machines/{MACHINE_NAME}"))

TARGET_UID_ENV = os.environ.get("TARGET_UID", "").strip()
TARGET_USER_ENV = os.environ.get("TARGET_USER", "").strip()

DESKTOP_DIR_CANDIDATES = (
    "usr/share/applications",
    "usr/local/share/applications",
)


def die(message: str, code: int = 1) -> NoReturn:
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(code)


def warn(message: str) -> None:
    print(f"Warning: {message}", file=sys.stderr)


def usage() -> None:
    print(
        f"""Usage:
  {Path(sys.argv[0]).name} <command> [args...]    : Run apt inside the '{MACHINE_NAME}' container
  {Path(sys.argv[0]).name} export <app_name>      : Export a GUI app's .desktop file to the host

Environment:
  TARGET_UID=1000            : UID used inside the container for GUI apps
  TARGET_USER=username       : Host user who receives exported .desktop files
  MACHINE_NAME=debian        : systemd-nspawn machine name
  CONTAINER_ROOT=/var/...    : Root path of the machine

Note for GUI apps:
  To run GUI apps, ensure your container allows access to X11/Wayland sockets.
  E.g., add to your {MACHINE_NAME}.nspawn file:
    BindReadOnly=/tmp/.X11-unix
    Bind=/run/user/1000
"""
    )


def resolve_target_user() -> str:
    if TARGET_USER_ENV:
        return TARGET_USER_ENV

    sudo_user = os.environ.get("SUDO_USER", "").strip()
    if sudo_user and sudo_user != "root":
        return sudo_user

    return getpass.getuser()


def resolve_target_home(user: str) -> Path:
    try:
        return Path(pwd.getpwnam(user).pw_dir)
    except KeyError:
        die(f"Could not resolve home directory for '{user}'.")


def resolve_target_uid() -> int:
    if TARGET_UID_ENV:
        try:
            return int(TARGET_UID_ENV)
        except ValueError:
            die(f"TARGET_UID must be an integer, got: {TARGET_UID_ENV!r}")

    user = resolve_target_user()
    try:
        return pwd.getpwnam(user).pw_uid
    except KeyError:
        die(f"Could not resolve UID for '{user}'.")


def resolve_target_gid(user: str) -> int:
    try:
        return pwd.getpwnam(user).pw_gid
    except KeyError:
        die(f"Could not resolve GID for '{user}'.")


def sanitize_slug(text: str) -> str:
    s = text.casefold()
    s = s.replace(" ", "-").replace("/", "-")
    s = re.sub(r"[^a-z0-9._-]+", "-", s)
    s = re.sub(r"-+", "-", s).strip("-")
    return s or "app"


def iter_desktop_files(root: Path) -> Iterable[Path]:
    for base in DESKTOP_DIR_CANDIDATES:
        directory = root / base
        if not directory.exists():
            continue
        yield from directory.rglob("*.desktop")


def find_desktop_file(app_name: str) -> Optional[Path]:
    needle = app_name.casefold()

    exact_matches: list[Path] = []
    partial_matches: list[Path] = []

    for path in iter_desktop_files(CONTAINER_ROOT):
        stem = path.stem.casefold()
        name = path.name.casefold()
        rel = str(path.relative_to(CONTAINER_ROOT)).casefold()

        if stem == needle or name == f"{needle}.desktop":
            exact_matches.append(path)
            continue

        if needle in stem or needle in name or needle in rel:
            partial_matches.append(path)
            continue

    if exact_matches:
        return sorted(exact_matches)[0]
    if partial_matches:
        return sorted(partial_matches)[0]
    return None


def first_desktop_value(text: str, key: str) -> str:
    prefix = f"{key}="
    for line in text.splitlines():
        if line.startswith(prefix):
            return line[len(prefix) :].strip()
    return ""


def ensure_dir_chown(path: Path, uid: int, gid: int) -> None:
    if path.exists():
        return
    
    paths_to_create = []
    current = path
    while not current.exists():
        paths_to_create.append(current)
        current = current.parent
        
    for p in reversed(paths_to_create):
        p.mkdir(exist_ok=True)
        os.chown(p, uid, gid)


def build_launcher_script(
    machine_name: str,
    target_uid: int,
    desktop_file: Path,
    display_name: str,
    orig_icon: str,
    orig_exec: str,
) -> str:
    machine_repr = repr(machine_name)
    target_uid_repr = repr(int(target_uid))
    desktop_file_repr = repr(str(desktop_file))
    display_name_repr = repr(display_name)
    orig_icon_repr = repr(orig_icon)
    orig_exec_repr = repr(orig_exec)

    return f"""#!/usr/bin/env python3
from __future__ import annotations

import os
import shlex
import sys

MACHINE = {machine_repr}
TARGET_UID = {target_uid_repr}
DESKTOP_FILE = {desktop_file_repr}
DISPLAY_NAME = {display_name_repr}
ORIG_ICON = {orig_icon_repr}
ORIG_EXEC = {orig_exec_repr}


def expand_exec(template: str, argv: list[str]) -> list[str]:
    tokens = shlex.split(template, posix=True)
    out: list[str] = []

    for token in tokens:
        if token == "%%":
            out.append("%")
            continue
        if token == "%c":
            out.append(DISPLAY_NAME)
            continue
        if token == "%k":
            out.append(DESKTOP_FILE)
            continue
        if token == "%i":
            if ORIG_ICON:
                out.extend(["--icon", ORIG_ICON])
            continue
        if token in ("%f", "%u"):
            if argv:
                out.append(argv[0])
            continue
        if token in ("%F", "%U"):
            out.extend(argv)
            continue

        if "%" in token:
            repl = token.replace("%%", "%")
            repl = repl.replace("%c", DISPLAY_NAME)
            repl = repl.replace("%k", DESKTOP_FILE)

            has_single = "%f" in repl or "%u" in repl
            has_multi = "%F" in repl or "%U" in repl

            if has_single:
                val = argv[0] if argv else ""
                repl = repl.replace("%f", val).replace("%u", val)
                
            if has_multi:
                val = argv[0] if argv else ""
                repl = repl.replace("%F", val).replace("%U", val)

            out.append(repl)
            
            if has_multi and len(argv) > 1:
                out.extend(argv[1:])
            continue

        out.append(token)

    return out


def main() -> None:
    clicked_args = sys.argv[1:]
    final_cmd = expand_exec(ORIG_EXEC, clicked_args)

    if not final_cmd:
        print("Error: command expansion resulted in an empty command.", file=sys.stderr)
        sys.exit(1)

    wayland = os.environ.get("WAYLAND_DISPLAY", "")
    display = os.environ.get("DISPLAY", "")

    cmd = [
        "systemd-run",
        "-M", MACHINE,
        "--quiet",
        "--pipe",
        "--wait",
        f"--uid={{TARGET_UID}}",
        f"--setenv=XDG_RUNTIME_DIR=/run/user/{{TARGET_UID}}",
    ]
    
    if wayland:
        cmd.append(f"--setenv=WAYLAND_DISPLAY={{wayland}}")
    if display:
        cmd.append(f"--setenv=DISPLAY={{display}}")

    cmd.extend([
        "--",
        "/usr/bin/env",
        *final_cmd,
    ])

    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
"""


def rewrite_desktop_file(
    desktop_path: Path,
    wrapper_path: Path,
    machine_name: str,
    container_root: Path,
    display_name: str,
) -> None:
    text = desktop_path.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines(True)

    out: list[str] = []
    seen_name = False
    seen_exec = False
    seen_tryexec = False

    quoted_wrapper = shlex.quote(str(wrapper_path))

    for line in lines:
        if line.startswith("Name=") or line.startswith("Name["):
            if not seen_name:
                out.append(f"Name=[{machine_name.capitalize()}] {display_name}\n")
                seen_name = True
            continue

        if line.startswith("Exec="):
            out.append(f"Exec={quoted_wrapper} %U\n")
            seen_exec = True
            continue

        if line.startswith("TryExec="):
            out.append(f"TryExec={quoted_wrapper}\n")
            seen_tryexec = True
            continue

        if line.startswith("Icon="):
            icon_value = line[len("Icon=") :].rstrip("\n")
            if icon_value.startswith("/"):
                out.append(f"Icon={container_root}{icon_value}\n")
            else:
                out.append(line)
            continue

        out.append(line)

    def insert_after_desktop_entry(target_lines: list[str], new_line: str) -> list[str]:
        inserted = False
        result: list[str] = []
        for line in target_lines:
            result.append(line)
            if not inserted and line.strip() == "[Desktop Entry]":
                result.append(new_line)
                inserted = True
        if not inserted:
            result.insert(0, new_line)
        return result

    if not seen_name:
        out = insert_after_desktop_entry(out, f"Name=[{machine_name.capitalize()}] {display_name}\n")
    if not seen_exec:
        out = insert_after_desktop_entry(out, f"Exec={wrapper_path} %U\n")
    if not seen_tryexec:
        out = insert_after_desktop_entry(out, f"TryExec={wrapper_path}\n")

    desktop_path.write_text("".join(out), encoding="utf-8")


def export_app(app_name: str) -> int:
    target_user = resolve_target_user()
    target_uid = resolve_target_uid()
    target_gid = resolve_target_gid(target_user)
    target_home = resolve_target_home(target_user)

    if not target_home.exists():
        die(f"Home directory does not exist: {target_home}")

    desktop_dir = target_home / ".local/share/applications"
    wrapper_dir = target_home / ".local/bin"
    
    ensure_dir_chown(desktop_dir, target_uid, target_gid)
    ensure_dir_chown(wrapper_dir, target_uid, target_gid)

    desktop_file = find_desktop_file(app_name)
    if desktop_file is None:
        die(f"No .desktop file found for '{app_name}' in the container.")

    file_name = desktop_file.name
    base_name = desktop_file.stem
    slug = sanitize_slug(base_name)

    output_desktop = desktop_dir / f"{MACHINE_NAME}-{file_name}"
    wrapper_file = wrapper_dir / f"{MACHINE_NAME}-{slug}-launch.py"

    src_text = desktop_file.read_text(encoding="utf-8", errors="replace")
    orig_name = first_desktop_value(src_text, "Name") or app_name
    orig_icon = first_desktop_value(src_text, "Icon")
    orig_exec = first_desktop_value(src_text, "Exec")

    if not orig_exec:
        die(f"Found desktop file, but no Exec= line was present: {desktop_file}")

    shutil.copy2(desktop_file, output_desktop)

    launcher = build_launcher_script(
        machine_name=MACHINE_NAME,
        target_uid=target_uid,
        desktop_file=output_desktop,
        display_name=orig_name,
        orig_icon=orig_icon,
        orig_exec=orig_exec,
    )
    wrapper_file.write_text(launcher, encoding="utf-8")
    os.chmod(wrapper_file, 0o755)

    rewrite_desktop_file(
        desktop_path=output_desktop,
        wrapper_path=wrapper_file,
        machine_name=MACHINE_NAME,
        container_root=CONTAINER_ROOT,
        display_name=orig_name,
    )

    os.chown(output_desktop, target_uid, target_gid)
    os.chown(wrapper_file, target_uid, target_gid)

    print("Export successful:")
    print(f"  Desktop : {output_desktop}")
    print(f"  Wrapper : {wrapper_file}")

    if shutil.which("update-desktop-database"):
        env = os.environ.copy()
        env["HOME"] = str(target_home)
        env["USER"] = target_user
        subprocess.run(
            ["update-desktop-database", str(desktop_dir)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            user=target_uid,
            group=target_gid,
            check=False,
        )

    return 0


def passthrough_apt(args: list[str]) -> NoReturn:
    if not args:
        usage()
        sys.exit(1)

    cmd = [
        "machinectl",
        "-q",
        "shell",
        f"root@{MACHINE_NAME}",
        "/usr/bin/apt",
        *args,
    ]
    os.execvp(cmd[0], cmd)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        usage()
        return 0 if argv and argv[0] in {"-h", "--help", "help"} else 1

    command = argv[0]
    rest = argv[1:]

    if command == "export":
        if not rest:
            die("Please specify an application name. Example: apt export firefox")
        return export_app(rest[0])

    passthrough_apt(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
